# API base. "/api/v1" goes through the Next.js rewrite, so cookies stay first party
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Where the rewrite forwards requests (no trailing slash, no /api/v1)
BACKEND_URL=http://localhost:5000

# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Must match CREDIT_PRICE_IN_CENTS in the backend
NEXT_PUBLIC_CREDIT_PRICE_CENTS=100
NEXT_PUBLIC_CONTACT_EMAIL=